# ---- AI provider (OpenAI-compatible). Leave empty to run default labs only.
# Works with OpenAI, DeepSeek, Groq, OpenRouter, local Ollama (base_url http://localhost:11434/v1) ...
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=120

# ---- Lab lifecycle
LAB_TTL_MINUTES=60
BUILD_PLATFORM=linux/amd64
MAX_CONCURRENT_LABS=3

# ---- Sandbox limits
MEM_LIMIT=256m
CPU_NANO=500000000
PIDS_LIMIT=128

# ---- Frontend (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173