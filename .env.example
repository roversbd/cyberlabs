# Template config. Copy to .env and edit:  cp .env.example .env
# .env is gitignored and must never be committed.

# ---- AI provider (OpenAI-compatible). Leave empty to run the default labs only.
# Works with OpenAI, DeepSeek, Groq, OpenRouter, local Ollama (base_url http://localhost:11434/v1) ...
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=120

# ---- Lab lifecycle
LAB_TTL_MINUTES=60
MAX_CONCURRENT_LABS=3

# ---- Sandbox limits
MEM_LIMIT=256m
CPU_NANO=500000
PIDS_LIMIT=128

# ---- Frontend (CORS)
CORS_ORIGINS=http://localhost:5173
